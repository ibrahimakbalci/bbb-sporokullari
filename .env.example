# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. .env asla paylaşılmamalı / commit edilmemelidir.

# Veritabanı (db.php getenv ile okur; Docker'da DB_HOST compose tarafından "db" olarak verilir)
DB_NAME=sporokullariburs_kayit
DB_USER=sporokullariburs_kayit
DB_PASS=degistir-beni
DB_ROOT_PASS=degistir-beni-root

# 1 = HTTP isteklerini HTTPS'e yönlendir (prod), 0 = kapalı (yerel geliştirme)
FORCE_HTTPS=0

# Yayın portları
APP_PORT=8080
PMA_PORT=8081

# Dev: ilk açılışta yüklenecek SQL. Boş bırakılırsa docker/db/init/01-schema.sql (veri içermeyen şema)
#DB_INIT_SQL=./sporokullariburs_kayit.sql
